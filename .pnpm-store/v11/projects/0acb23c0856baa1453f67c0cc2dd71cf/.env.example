# PostgreSQL connection string; never commit the real .env file.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/fefcomputer?schema=public"
NODE_ENV="development"
PORT="3000"
CORS_ORIGIN="http://localhost:5173"
JWT_ACCESS_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
